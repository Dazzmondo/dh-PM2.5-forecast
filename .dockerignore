# Keep the build context small and keep secrets, data and private files out of the image.

# version control and local environments
.git
.gitignore
.venv
venv
**/__pycache__
**/*.pyc

# data, run records and models are mounted at run time, never baked into the image
raw_data
processed_data
mlruns
models
drafts
reports

# credentials: never in an image
.env
service-account*.json
*credentials*.json
*-key.json

# private working files and documentation
CLAUDE.md
docs

# git-ignored local download of EEA metadata tables (not needed to run the experiments)
metadata/source_metadata
